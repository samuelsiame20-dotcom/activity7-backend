# Copy this file to .env and fill in real values. NEVER commit .env to Git.

# PostgreSQL connection string.
# Local example:  postgres://postgres:yourpassword@localhost:5432/campus
# Render: use the "Internal Database URL" when the API is also on Render.
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/campus

# Frontend sites allowed to call this API from a browser (comma-separated).
CLIENT_ORIGINS=https://campus-maintenance-siame.netlify.app,http://127.0.0.1:5500,http://localhost:5500

# Optional: force SSL on/off (normally detected automatically).
# DATABASE_SSL=true

PORT=3000
